# GitHub token (public_repo read is enough). Needed to search people across VOUCHED.td files; falls back to `gh auth token`.
GITHUB_TOKEN=
# Groq (https://console.groq.com/keys). Model must support JSON-schema output.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Sign in with GitHub: an OAuth app (github.com/settings/developers) with callback URL <site>/api/auth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the site's address, when the callback registered on GitHub is not on the address you browse
# (e.g. http://127.0.0.1:3000, or the public URL behind a proxy).
APP_URL=
# Encrypts the session cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
