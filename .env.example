# GitHub token (public_repo read is enough). If unset, scripts fall back to `gh auth token`.
GITHUB_TOKEN=
# Groq (https://console.groq.com/keys). Model must support JSON-schema output.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=file:./data/vouch.db
NEXT_PUBLIC_DEMO_USER=Calonca
# Shared trust index (Lakebase Postgres on Neon), read-only and optional.
# Unset = local SQLite only. Pooled (-pooler) host, SELECT-only role.
NEON_DATABASE_URL=
# Write credential for scripts/sharedCrawl.ts ONLY. Direct (non-pooler) host. The app must never use it.
NEON_WRITE_URL=
